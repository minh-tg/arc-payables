# Arc Testnet Configuration (Circle L1, gas token is USDC)
# Run `uv run arc-canteen rpc-url` to retrieve your personal RPC endpoint
ARC_RPC_URL=https://testnet-rpc.arc.network
RPC_URL=https://testnet-rpc.arc.network

# Chain ID for Arc Testnet
ARC_CHAIN_ID=5042002

# Testnet Wallet Private Key
# Retrieve using `uv run arc-canteen wallet`
PRIVATE_KEY=

# Explorer verification (ArcScan)
ETHERSCAN_API_KEY=arc
