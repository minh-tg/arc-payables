# Local API and deterministic demo policy
ENVIRONMENT=local
DATABASE_PATH=data/arc_payables.sqlite3
PAYMENT_PROVIDER=mock
ACCOUNTING_PROVIDER=mock
POLICY_VERSION=arc-payables-ap-v1
MAX_INVOICE_USDC=1000
MIN_RESERVE_USDC=2000
MAX_TREASURY_SNAPSHOT_AGE_SECONDS=90
PERMIT_LIFETIME_SECONDS=300
PAYMENT_DUE_WINDOW_DAYS=3
DISCOUNT_MIN_PERCENT=0
API_KEY=
APPROVAL_TOKEN=

# Circle Developer-Controlled Wallets: Arc Testnet ONLY.
# Circle account must be an SCA on ARC-TESTNET; no EOA raw-key path is used.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_ID=
CIRCLE_WALLET_ADDRESS=
CIRCLE_GUARD_ADDRESS=
CIRCLE_RPC_URL=https://rpc.testnet.arc.io
# Circle's real API base. Point this at the local test executor for a credential-free run.
CIRCLE_API_BASE_URL=https://api.circle.com/v1/w3s
PERMIT_SIGNING_PRIVATE_KEY=
# Required address of the policy signer. When set, start-up refuses a key that does not match,
# and read-only verification (arc-payables-verify-arc, /setup) compares it to the guard without
# opening the token.
PERMIT_SIGNING_ADDRESS=
# env (testnet/MVP), pkcs11 (managed key on a token), or kms (unimplemented; fails closed).
SIGNER_BACKEND=env

# Managed PKCS#11 policy signing. Use a real HSM in production; SoftHSM2 is a software test
# double only. The private key must be non-extractable and secp256k1, and start-up refuses a
# key that is extractable, on the wrong curve, or readable.
PKCS11_LIB_PATH=
# Pin the token slot when the host exposes more than one token.
PKCS11_SLOT=
PKCS11_KEY_LABEL=
PKCS11_KEY_ID_HEX=01
PKCS11_USER_PIN=
# Development marker: refused by the signer factory. Documents that SoftHSM2 is not a real HSM.
PKCS11_TEST_BACKEND=false
# Addresses of retired policy keys whose historical audit signatures must still verify after a
# rotation. A compromised key must NOT be listed here. Explicit list; nothing is accepted implicitly.
PERMIT_SIGNING_RETIRED_ADDRESSES=

# Advisory decision layer. Optional: the service is complete with the deterministic policy
# alone. `policy` uses no advisory opinion, `heuristics` is the fast explainable layer, and
# `dual_process` adds a bounded planner consulted only for genuine trade-offs. A planner can
# never authorize, redirect or resize a payment; the policy and the guard decide.
DECISION_LAYER=heuristics
# Used only when DECISION_LAYER=dual_process and both of these are set.
# TRUST BOUNDARY: the planner receives invoice and supplier details in its prompt. Point this only at
# an endpoint you would send those documents to, and prefer https:// (no scheme is enforced, so an
# http:// value would send them in cleartext). Its answer is advisory and is validated to be a
# reordering of the already-eligible invoices; it can never add, drop, resize or authorize a payment.
PLANNER_BASE_URL=
PLANNER_API_KEY=
PLANNER_MODEL=
PLANNER_TIMEOUT_SECONDS=20
PLANNER_MAX_TOKENS=700

# Local-key (EOA) executor: an alternative to Circle for Arc Testnet runs and for developing
# without Circle credentials. It keeps the same path (exact approve, then the policy-signed
# guard call) and the same on-chain budgets; only the location of the payer key differs.
# PAYMENT_PROVIDER=local selects it. Testnet only, and the key must not be reused elsewhere.
LOCAL_PAYMENT_PRIVATE_KEY=
LOCAL_PAYMENT_ADDRESS=
LOCAL_PAYMENT_RPC_URL=https://rpc.testnet.arc.io
LOCAL_PAYMENT_GUARD_ADDRESS=
LOCAL_PAYMENT_TIMEOUT_SECONDS=20
LOCAL_PAYMENT_RECEIPT_TIMEOUT_SECONDS=90
LOCAL_PAYMENT_LOG_LOOKBACK_BLOCKS=20000
CIRCLE_POLL_INTERVAL_SECONDS=2
CIRCLE_CONFIRMATION_TIMEOUT_SECONDS=90

# Foundry deployment only; keep the deployer key local and outside source control.
DEPLOYER_PRIVATE_KEY=

# PaymentGuard budget. Deployment refuses to proceed without an explicit budget, because a
# guard deployed without one is exactly the failure this contract exists to prevent, and the
# caps are immutable afterwards: changing a budget means deploying a new guard.
# Amounts are ERC-20 USDC units (6 decimals); the epoch length is in seconds (minimum 60).
# The epoch cap must be able to cover at least one full payment.
PAYMENT_GUARD_PER_PAYMENT_CAP=
PAYMENT_GUARD_EPOCH_CAP=
PAYMENT_GUARD_RECIPIENT_EPOCH_CAP=
PAYMENT_GUARD_EPOCH_LENGTH_SECONDS=
# Address that may pause and unpause the guard. Pausing only stops payments; it cannot move funds,
# redirect one, or raise a cap. Set it to a burn address if you want no pause authority at all.
# It must differ from the policy signer.
PAYMENT_GUARD_PAUSER=

# Frappe/ERPNext REST API v1; use a dedicated least-privilege API user.
FRAPPE_URL=
FRAPPE_API_KEY=
FRAPPE_API_SECRET=
FRAPPE_TIMEOUT_SECONDS=12
FRAPPE_SUPPLIER_WALLET_FIELD=custom_usdc_wallet_address
FRAPPE_SUPPLIER_WALLET_VERIFIED_FIELD=custom_usdc_wallet_verified
FRAPPE_INVOICE_PAYEE_FIELD=

# Accounting mapping. Demo assumptions, NOT production accounting guidance:
#   * company base currency and invoice currency are USD
#   * USDC is the settlement asset; the wallet account is denominated in USDC
#   * the payable and network-fee accounts are in the company currency
#   * the Arc network fee is absorbed by us and expensed; it never reduces the supplier amount
# FRAPPE_SOURCE_EXCHANGE_RATE is company-currency units per 1 USDC (1.0 for a 1:1 peg).
FRAPPE_COMPANY=
FRAPPE_PAID_FROM_ACCOUNT=
FRAPPE_PAID_TO_ACCOUNT=
FRAPPE_MODE_OF_PAYMENT=
FRAPPE_SETTLEMENT_CURRENCY=USDC
FRAPPE_COMPANY_CURRENCY=USD
FRAPPE_INVOICE_CURRENCY=USD
FRAPPE_SOURCE_EXCHANGE_RATE=1
FRAPPE_TARGET_EXCHANGE_RATE=1
FRAPPE_FEE_ACCOUNT=
# Cost centre for the network fee. ERPNext requires a cost centre on an expense row and refuses to guess.
FRAPPE_COST_CENTER=
FRAPPE_FEE_CURRENCY=USD

# The background worker (uv run arc-payables-worker). It reconciles unconfirmed settlements, finishes
# ledger writebacks, re-screens counterparties on cadence, and reports the treasury. Paying on its own
# is opt-in: an unattended spend is a policy to state, not to inherit.
WORKER_INTERVAL_SECONDS=60
WORKER_AUTOPAY=false
# Import and evaluate payables the ledger still owes, so the queue stays current with nobody
# pressing anything. Discovery is not approval: an invoice that fails a policy check escalates for
# a person, and payment stays governed by WORKER_AUTOPAY.
WORKER_INTAKE=true
# Ceiling on actions per pass. What a pass defers is picked up by the next one, never dropped.
WORKER_MAX_ACTIONS_PER_PASS=25

# Retrying a broken ledger forever is noise; not retrying it is a silent leak. A definite failure
# (nothing written) backs off per payment; an uncertain one (response lost after the write) keeps its
# claim until the lease expires and is reconciled rather than repeated by guess.
WRITEBACK_BACKOFF_SECONDS=60
WRITEBACK_BACKOFF_MAX_SECONDS=3600
WRITEBACK_LEASE_SECONDS=120

# Alerts. Empty means no destination: alerts are still computed and recorded on every pass, and
# /metrics exposes the numbers they are derived from. A configured URL receives one POST per distinct
# alert per interval, so an alert that stays true does not repeat itself endlessly.
ALERT_WEBHOOK_URL=
ALERT_MIN_INTERVAL_SECONDS=3600
ALERT_AFTER_CONSECUTIVE_FAILURES=3

# Local backups, made from the console or the CLI. Each one is a full copy of the database, so keep
# the directory under the same access control as the database. BACKUP_KEEP is how many complete
# backups to retain before the oldest are pruned.
BACKUP_DIRECTORY=data/backups
BACKUP_KEEP=48
