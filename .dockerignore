# Deny by default: neither local credentials/data nor private notes reach a remote build context.
**
!pyproject.toml
!uv.lock
!README.md
!LICENSE
!src/
!src/**
!migrations/
!migrations/**
!deploy/
!deploy/arc-payables/
!deploy/arc-payables/Dockerfile
!deploy/arc-payables/worker_healthcheck.py
# Keep secrets and generated files excluded even beneath an allowlisted source directory.
**/.env*
**/*.secret
**/*.key
**/*.pem
**/*.sqlite3
**/__pycache__/
**/__pycache__/**
# Explicit defense-in-depth exclusions also document the publication boundary.
HANDOFF.md
local-docs/
.secret
*.secret
.env
.env.*
*.key
*.pem
*-recovery-file.json
recovery/
data/
*.sqlite3
